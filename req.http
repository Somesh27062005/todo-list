### User registration
POST http://localhost:8000/user-api/user
Content-Type: application/json

{
    "name": "Test User",
    "email": "test1@gmail.com",
    "password": "password123"
}

### User login
POST http://localhost:8000/user-api/login
Content-Type: application/json

{
    "email": "test1@gmail.com",
    "password": "password123"
}

### Add task
PUT http://localhost:8000/user-api/todo/69315aeffd9d1d7891356902
Content-Type: application/json

{
    "taskName": "Prepare presentation",
    "description": "Finalize slides for sprint demo",
    "dueDate": "2026-11-15"
}

### Edit pending task
PUT http://localhost:8000/user-api/edit-todo/userid/6931407ee6006acb9bf68e9b/taskid/69314a5cabb4ebc4319f539c
Content-Type: application/json

{
    "taskName": "Prepare presentation",
    "description": "Finalize slides and demo notes",
    "dueDate": "2026-11-16"
}

### Mark task as completed
PUT http://localhost:8000/user-api/edit-status/userid/6931407ee6006acb9bf68e9b/taskid/69314a5cabb4ebc4319f539c
Content-Type: application/json

{}

### Delete task
PUT http://localhost:8000/user-api/delete-todo/userid/69315aeffd9d1d7891356902/taskid/69315b315a1aa79b31def256
Content-Type: application/json

{}

### Clear completed tasks
PUT http://localhost:8000/user-api/clear-completed/69315aeffd9d1d7891356902
Content-Type: application/json

{}
